# Vapi — https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_WEBHOOK_SECRET=your_webhook_secret_here   # Optional but recommended

# AssemblyAI — used by custom_transcriber.py (STT 3.7 Realtime Agent).
# For the built-in provider, add the same key in the Vapi dashboard under Integrations.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Custom transcriber (python create_assistant.py create --transcriber custom)
CUSTOM_TRANSCRIBER_URL=wss://your-ngrok-url.ngrok.io/api/custom-transcriber
TRANSCRIBER_SECRET=choose_a_long_random_string   # optional
KEYTERMS=Acme Insurance,Gold plan,deductible     # optional, comma-separated

# OpenAI (used by Vapi for LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Twilio (only needed for outbound calls)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
